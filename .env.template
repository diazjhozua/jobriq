# ─────────────────────────────────────────────────────────────────────────────
# Jobriq — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Required — your OpenAI API key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional — model to use for resume enhancement
# Options: gpt-4o | gpt-4.1 | gpt-4o-mini | gpt-4.1-mini
# Default: gpt-4o (best balance of quality and speed)
OPENAI_MODEL=gpt-4o

# Optional — custom API base URL (for Azure OpenAI, proxies, or local models)
# Leave blank to use the default OpenAI endpoint (https://api.openai.com/v1)
OPENAI_BASE_URL=
