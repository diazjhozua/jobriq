{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(npm run start)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test:e2e)",
      "Bash(npm --prefix client run lint)",
      "Bash(npm --prefix client run typecheck)",
      "Bash(npm --prefix client test)",
      "Bash(npm --prefix tests/e2e test)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git log --oneline)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/bin/**)",
      "Read(./**/obj/**)",
      "Read(./src/Jobriq.Web/wwwroot/**)",
      "Read(./tests/e2e/test-results/**)",
      "Read(./client/node_modules/**)",
      "Write(./src/Jobriq.Web/wwwroot/**)",
      "Write(./**/bin/**)",
      "Write(./**/obj/**)",
      "Edit(./src/Jobriq.Web/wwwroot/**)",
      "Edit(./**/bin/**)",
      "Edit(./**/obj/**)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commit.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-write.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-stop.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true
  }
}
